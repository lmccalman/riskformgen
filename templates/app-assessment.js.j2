document.addEventListener('alpine:init', () => {
  Alpine.data('assessment', () => ({
    activeTab: Alpine.$persist('risks').as('_x_a_activeTab'),
    answers: Alpine.$persist({{ answers_init_js }}).as('_x_a_answers'),
    details: Alpine.$persist({{ details_init_js }}).as('_x_a_details'),
    control_effectiveness: Alpine.$persist({{ control_effectiveness_init_js }}).as('_x_a_control_effectiveness'),
    residual_likelihood: Alpine.$persist({{ residual_likelihood_init_js }}).as('_x_a_residual_likelihood'),
    residual_consequence: Alpine.$persist({{ residual_consequence_init_js }}).as('_x_a_residual_consequence'),
    justifications: Alpine.$persist({{ justifications_init_js }}).as('_x_a_justifications'),
    mandated_controls: Alpine.$persist({{ mandated_controls_init_js }}).as('_x_a_mandated_controls'),
    mandated_comments: Alpine.$persist({{ mandated_comments_init_js }}).as('_x_a_mandated_comments'),
    aggregate_residual_level: Alpine.$persist({{ aggregate_residual_level_init_js }}).as('_x_a_aggregate_residual_level'),
    aggregate_residual_justification: Alpine.$persist({{ aggregate_residual_justification_init_js }}).as('_x_a_aggregate_residual_justification'),
    _questionIds: {{ question_ids_js }},
    _detailIds: {{ detail_ids_js }},
    _propertyIds: {{ property_ids_js }},
    _riskIds: {{ risk_ids_js }},
    _controlIds: {{ control_ids_js }},
    _riskConditions: {{ risk_conditions_js }},
    _buildId: '{{ build_id }}',
    _likelihoods: {{ likelihoods_js }},
    _consequences: {{ consequences_js }},
    _riskLevels: {{ risk_levels_js }},
    _risk_matrix: {{ risk_matrix_js }},
    init() {
      // Fill gaps when $persist restores state from a previous build that predates newly-added IDs.
      for (const id of this._questionIds) {
        if (!(id in this.answers)) this.answers[id] = '';
      }
      for (const id of this._detailIds) {
        if (!(id in this.details)) this.details[id] = '';
      }
      for (const id of this._riskIds) {
        if (!(id in this.justifications)) this.justifications[id] = '';
        if (!(id in this.control_effectiveness)) this.control_effectiveness[id] = '';
        if (!(id in this.residual_likelihood)) this.residual_likelihood[id] = '';
        if (!(id in this.residual_consequence)) this.residual_consequence[id] = '';
        if (!(id in this.mandated_controls)) this.mandated_controls[id] = {};
        if (!(id in this.mandated_comments)) this.mandated_comments[id] = {};
        for (const cid of (this._controlIds[id] || [])) {
          if (!(cid in this.mandated_controls[id])) this.mandated_controls[id][cid] = false;
          if (!(cid in this.mandated_comments[id])) this.mandated_comments[id][cid] = '';
        }
      }
      if (typeof this.aggregate_residual_level !== 'string') this.aggregate_residual_level = '';
      if (typeof this.aggregate_residual_justification !== 'string') this.aggregate_residual_justification = '';
    },
    _worst(results, dim, scale) {
      const vals = results.map(r => r[dim]).filter(v => v !== null);
      if (vals.length === 0) return null;
      return vals.reduce((w, v) => scale.indexOf(v) > scale.indexOf(w) ? v : w);
    },
    _worstLevel(levels, scale) {
      const candidates = levels.filter(lvl => lvl && lvl !== 'not_applicable');
      if (candidates.length === 0) return 'not_applicable';
      return candidates.reduce((w, v) => scale.indexOf(v) > scale.indexOf(w) ? v : w);
    },
    get aggregate_residual_level_default() {
      const levels = this._riskIds.map(id => this[`${id}_residual`].level);
      return this._worstLevel(levels, this._riskLevels);
    },
    _downloadJson(data, filename) {
      const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    },
    _freshAssessment() {
      const freshEffectiveness = {};
      const freshResidualL = {};
      const freshResidualC = {};
      const freshJustifications = {};
      const freshMandated = {};
      const freshComments = {};
      for (const id of this._riskIds) {
        freshEffectiveness[id] = '';
        freshResidualL[id] = '';
        freshResidualC[id] = '';
        freshJustifications[id] = '';
        freshMandated[id] = {};
        freshComments[id] = {};
        for (const ctrl of (this._controlIds[id] || [])) {
          freshMandated[id][ctrl] = false;
          freshComments[id][ctrl] = '';
        }
      }
      this.control_effectiveness = freshEffectiveness;
      this.residual_likelihood = freshResidualL;
      this.residual_consequence = freshResidualC;
      this.justifications = freshJustifications;
      this.mandated_controls = freshMandated;
      this.mandated_comments = freshComments;
      this.aggregate_residual_level = '';
      this.aggregate_residual_justification = '';
    },
    clearAssessment() {
      if (!confirm('Clear all risk assessments? Loaded answers will not be affected.')) return;
      this._freshAssessment();
    },
    _importJson(event, {format, version, fileIdsKey, currentIds, label, count, apply}) {
      const file = event.target.files[0];
      if (!file) return;
      event.target.value = '';
      const reader = new FileReader();
      reader.onload = () => {
        let data;
        try { data = JSON.parse(reader.result); }
        catch { alert('Invalid JSON file.'); return; }
        if (data.format !== format) {
          alert(`This is not a ${label} file. Expected format: ${format}`);
          return;
        }
        const versionMismatch = data.version !== version;
        const buildIdMismatch = !!data.build_id && !!this._buildId && data.build_id !== this._buildId;
        const fileIds = new Set(data[fileIdsKey] || []);
        const currentIdSet = new Set(currentIds);
        const added = currentIds.filter(id => !fileIds.has(id));
        const removed = (data[fileIdsKey] || []).filter(id => !currentIdSet.has(id));
        const {loaded, skippedType = 0} = count(data, currentIds);
        const parts = [`Load ${loaded} of ${currentIds.length} ${label}?`];
        if (added.length) parts.push(`${added.length} new since export (left at defaults).`);
        if (removed.length) parts.push(`${removed.length} exported skipped (removed).`);
        if (skippedType) parts.push(`${skippedType} skipped (type mismatch).`);
        if (buildIdMismatch) parts.push(`Exported from build ${data.build_id} (current: ${this._buildId}).`);
        if (versionMismatch) parts.push(`Schema version was ${data.version} (current: ${version}) — fields may not all carry over.`);
        const cleanLoad = loaded === currentIds.length && !removed.length && !skippedType && !versionMismatch;
        if (cleanLoad) {
          /* IDs align and schema matches — load silently even if build_id differs. */
        } else if (!confirm(parts.join(' '))) {
          return;
        }
        apply(data, currentIds);
      };
      reader.readAsText(file);
    },
    importAnswers(event) {
      this._importJson(event, {
        format: 'riskformgen-answers',
        version: 2,
        fileIdsKey: 'question_ids',
        currentIds: this._questionIds,
        label: 'answers',
        count: (data, ids) => {
          let loaded = 0;
          for (const id of ids) {
            if (!(id in data.answers)) continue;
            loaded++;
          }
          return {loaded};
        },
        apply: (data, ids) => {
          for (const id of ids) {
            if (!(id in data.answers)) continue;
            this.answers[id] = data.answers[id];
          }
          if (data.details) {
            for (const did of this._detailIds) {
              if (did in data.details) this.details[did] = data.details[did];
            }
          }
        },
      });
    },
    _propertySnapshot() {
      const snapshot = {};
      for (const id of this._propertyIds) snapshot[id] = this[`prop_${id}`];
      return snapshot;
    },
    _inherentSnapshot() {
      const snapshot = {};
      for (const id of this._riskIds) {
        const inh = this[id];
        const firing = (this._riskConditions[id] || []).filter(p => this[`prop_${p}`] === true);
        snapshot[id] = {
          likelihood: inh.likelihood,
          consequence: inh.consequence,
          level: inh.level,
          firing_conditions: firing,
        };
      }
      return snapshot;
    },
    exportAssessment() {
      this._downloadJson({
        format: 'riskformgen-assessment',
        version: 4,
        build_id: this._buildId,
        exported_at: new Date().toISOString(),
        risk_ids: this._riskIds,
        property_ids: this._propertyIds,
        properties: this._propertySnapshot(),
        inherent: this._inherentSnapshot(),
        control_effectiveness: this.control_effectiveness,
        residual_likelihood: this.residual_likelihood,
        residual_consequence: this.residual_consequence,
        justifications: this.justifications,
        mandated_controls: this.mandated_controls,
        mandated_comments: this.mandated_comments,
        aggregate_residual_level: this.aggregate_residual_level,
        aggregate_residual_justification: this.aggregate_residual_justification,
      }, 'riskformgen-assessment.json');
    },
    importAssessment(event) {
      this._importJson(event, {
        format: 'riskformgen-assessment',
        version: 4,
        fileIdsKey: 'risk_ids',
        currentIds: this._riskIds,
        label: 'assessments',
        count: (data, ids) => {
          let loaded = 0;
          for (const id of ids) {
            if (
              id in (data.control_effectiveness || {}) ||
              id in (data.residual_likelihood || {}) ||
              id in (data.residual_consequence || {}) ||
              id in (data.justifications || {})
            ) loaded++;
          }
          return {loaded};
        },
        apply: (data, ids) => {
          for (const id of ids) {
            if (data.control_effectiveness && id in data.control_effectiveness) {
              this.control_effectiveness[id] = data.control_effectiveness[id];
            }
            if (data.residual_likelihood && id in data.residual_likelihood) {
              this.residual_likelihood[id] = data.residual_likelihood[id];
            }
            if (data.residual_consequence && id in data.residual_consequence) {
              this.residual_consequence[id] = data.residual_consequence[id];
            }
            if (data.justifications && id in data.justifications) {
              this.justifications[id] = data.justifications[id];
            }
            if (data.mandated_controls && data.mandated_controls[id]) {
              for (const [ctrl, val] of Object.entries(data.mandated_controls[id])) {
                if (this.mandated_controls[id] && ctrl in this.mandated_controls[id]) {
                  this.mandated_controls[id][ctrl] = val;
                }
              }
            }
            if (data.mandated_comments && data.mandated_comments[id]) {
              for (const [ctrl, val] of Object.entries(data.mandated_comments[id])) {
                if (this.mandated_comments[id] && ctrl in this.mandated_comments[id]) {
                  this.mandated_comments[id][ctrl] = val;
                }
              }
            }
          }
          if (typeof data.aggregate_residual_level === 'string') {
            this.aggregate_residual_level = data.aggregate_residual_level;
          }
          if (typeof data.aggregate_residual_justification === 'string') {
            this.aggregate_residual_justification = data.aggregate_residual_justification;
          }
        },
      });
    },
    {% for prop in property_getters %}
    get prop_{{ prop.id }}() {
      {{ prop.js_body }}
    },
    {% endfor %}
    {% for ctrl in control_getters %}
    get ctrl_{{ ctrl.id }}() { return {{ ctrl.js }}; },
    {% endfor %}
    {% for risk in risks %}
    get {{ risk.id }}() {
      const results = [
        {% for js in risk.rules_js %}
        ({{ js }}),
        {% endfor %}
      ].filter(r => r !== null);
      if (results.length === 0) return {likelihood: null, consequence: null, level: 'not_applicable'};
      const likelihood = this._worst(results, 'likelihood', this._likelihoods);
      const consequence = this._worst(results, 'consequence', this._consequences);
      return {
        likelihood, consequence,
        level: (this._risk_matrix[likelihood] || {})[consequence] || 'not_applicable'
      };
    },
    get {{ risk.id }}_residual() {
      const inherent = this.{{ risk.id }};
      if (inherent.level === 'not_applicable') return inherent;
      const eff = this.control_effectiveness['{{ risk.id }}'] || 'ineffective';
      if (eff === 'ineffective') return inherent;
      if (eff === 'controlled') return {
        likelihood: inherent.likelihood,
        consequence: inherent.consequence,
        level: 'controlled'
      };
      const rL = this.residual_likelihood['{{ risk.id }}'];
      const rC = this.residual_consequence['{{ risk.id }}'];
      if (!rL || !rC) return inherent;
      return {
        likelihood: rL,
        consequence: rC,
        level: (this._risk_matrix[rL] || {})[rC] || 'not_applicable'
      };
    },
    {% endfor %}
  }));
});

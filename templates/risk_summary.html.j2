<div class="card mb-4">
  {# ── Header ── #}
  <header class="card-header">
    <p class="card-header-title">{{ risk.id | replace("_", " ") | title }}</p>
    <span
      class="tag is-info is-light is-small risk-changed-badge"
      x-show="diffMode && riskInherentChanged('{{ risk.id }}')"
      x-cloak
    >Changed since prior</span>
  </header>

  <div class="card-content risk-card-body">
    <p class="subtitle is-6 has-text-grey">{{ risk.description }}</p>
    {% if risk.guidance %}
    <p class="help"><em>{{ risk.guidance }}</em></p>
    {% endif %}

    {# ── Modelled risk: likelihood × consequence → level ── #}
    <div class="risk-card-section">
      <div class="risk-grid">
        {# Likelihood #}
        <div>
          <span class="dim-label">Likelihood</span>
          <span
            class="badge badge-blue"
            x-text="({{ risk.id }}.likelihood || '—').replace(/_/g, ' ')"
          ></span>
        </div>

        {# Consequence #}
        <div>
          <span class="dim-label">Consequence</span>
          <span
            class="badge badge-purple"
            x-text="({{ risk.id }}.consequence || '—').replace(/_/g, ' ')"
          ></span>
        </div>

        {# Modelled risk level (colour-coded) #}
        <div>
          <span class="dim-label">Modelled Risk</span>
          <span
            class="badge"
            :class="'badge-' + ({ {% for level, colour in risk_level_colours.items() %}'{{ level }}': '{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %} }[{{ risk.id }}.level] || 'gray')"
            x-text="{{ risk.id }}.level.replace(/_/g, ' ')"
          ></span>
        </div>
      </div>
    </div>

    {# ── Controls ── #}
    {% if risk.controls %}
    <div class="risk-card-section">
      <span class="dim-label">Controls</span>
      <div class="stack-sm">
        {% for ctrl in risk.controls %}
        <div class="control-row">
          <span
            class="control-icon"
            :class="ctrl_{{ ctrl.id }}
              ? 'control-icon-active'
              : 'control-icon-inactive'"
            x-text="ctrl_{{ ctrl.id }} ? '✓' : '✗'"
          ></span>
          <span
            :class="ctrl_{{ ctrl.id }} ? '' : 'answer-missing'"
            >{{ ctrl.description }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# ── Mandate Controls ── #}
    {% if risk.controls %}
    <div class="risk-card-section">
      <span class="dim-label">Mandate Controls</span>
      <div class="stack-sm">
        {% for ctrl in risk.controls %}
        <template x-if="!ctrl_{{ ctrl.id }}">
          <div>
            <label class="checkbox">
              <input type="checkbox"
                x-model="mandated_controls['{{ risk.id }}']['{{ ctrl.id }}']"
              />
              {{ ctrl.description }}
            </label>
            <div x-show="mandated_controls['{{ risk.id }}']['{{ ctrl.id }}']" x-cloak>
              <textarea
                class="textarea"
                x-model="mandated_comments['{{ risk.id }}']['{{ ctrl.id }}']"
                rows="2"
                placeholder="How should this control be implemented…"
              ></textarea>
            </div>
          </div>
        </template>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# ── Context (detail text relevant to this risk) ── #}
    {% if risk.relevant_details %}
    <div class="risk-card-section">
      <span class="dim-label">Context</span>
      <div class="stack-sm">
        {% for detail in risk.relevant_details %}
        <div
          x-show="({{ detail.show_js }}) && details['{{ detail.id }}']"
          x-cloak
        >
          <p class="has-text-weight-semibold is-size-7">{{ detail.description }}</p>
          <p class="linked-answer" x-text="details['{{ detail.id }}']"></p>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# ── Residual risk (assessor judgement) ── #}
    <div
      class="risk-card-section"
      x-show="{{ risk.id }}.level !== 'not_applicable'"
      x-cloak
    >
      <span class="dim-label">Control Effectiveness</span>
      <p
        class="prior-residual-hint help"
        x-show="diffMode && priorResidual('{{ risk.id }}') && priorResidual('{{ risk.id }}').effectiveness"
        x-cloak
      >
        Previously: <span x-text="priorResidual('{{ risk.id }}') && priorResidual('{{ risk.id }}').effectiveness"></span>
        <template x-if="priorResidual('{{ risk.id }}') && priorResidual('{{ risk.id }}').likelihood">
          <span>
            (residual L/C:
            <span x-text="priorResidual('{{ risk.id }}').likelihood"></span> /
            <span x-text="priorResidual('{{ risk.id }}').consequence"></span>)
          </span>
        </template>
      </p>
      <div class="options-row">
        <label class="radio">
          <input
            type="radio"
            value="ineffective"
            x-model="control_effectiveness['{{ risk.id }}']"
          />
          Ineffective
        </label>
        <label class="radio">
          <input
            type="radio"
            value="partial"
            x-model="control_effectiveness['{{ risk.id }}']"
          />
          Partial
        </label>
        <label class="radio">
          <input
            type="radio"
            value="controlled"
            x-model="control_effectiveness['{{ risk.id }}']"
          />
          Controlled
        </label>
      </div>

      <template x-if="control_effectiveness['{{ risk.id }}'] === 'partial'">
        <div class="risk-grid" style="margin-top: 0.75rem;">
          <div>
            <span class="dim-label">Residual Likelihood</span>
            <div
              class="select is-small"
              :class="!residual_likelihood['{{ risk.id }}'] ? 'is-danger' : ''"
            >
              <select x-model="residual_likelihood['{{ risk.id }}']">
                <option value="">— Select —</option>
                {% for lk in likelihoods %}
                <option value="{{ lk }}">{{ lk | replace("_", " ") | title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div>
            <span class="dim-label">Residual Consequence</span>
            <div
              class="select is-small"
              :class="!residual_consequence['{{ risk.id }}'] ? 'is-danger' : ''"
            >
              <select x-model="residual_consequence['{{ risk.id }}']">
                <option value="">— Select —</option>
                {% for cs in consequences %}
                <option value="{{ cs }}">{{ cs | replace("_", " ") | title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div></div>
        </div>
      </template>

      <div style="margin-top: 0.75rem;">
        <span class="dim-label">Residual Risk</span>
        <span
          class="badge"
          :class="'badge-' + ({ {% for level, colour in risk_level_colours.items() %}'{{ level }}': '{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %} }[{{ risk.id }}_residual.level] || 'gray')"
          x-text="{{ risk.id }}_residual.level.replace(/_/g, ' ')"
        ></span>
      </div>

      {% if risk.controls %}
      <p
        class="help is-warning"
        x-show="control_effectiveness['{{ risk.id }}'] === 'controlled' && !({% for ctrl in risk.controls %}ctrl_{{ ctrl.id }}{% if not loop.last %} || {% endif %}{% endfor %})"
        x-cloak
      >
        No controls are currently marked present. Provide justification.
      </p>
      {% endif %}
    </div>

    {# ── Justification ── #}
    <div
      class="risk-card-section"
      x-show="{{ risk.id }}.level !== 'not_applicable'"
      x-cloak
    >
      <label class="dim-label" for="justification_{{ risk.id }}">Residual Risk Justification</label>
      <div>
        <textarea
          class="textarea"
          id="justification_{{ risk.id }}"
          x-model="justifications.{{ risk.id }}"
          rows="2"
          placeholder="Provide reasoning for the residual risk, control effectiveness, and any compensating factors…"
        ></textarea>
      </div>
    </div>

  </div>
</div>

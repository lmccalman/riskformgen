<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registry — FormGen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="{{ asset_prefix }}bulma.min.css" />
    <link rel="stylesheet" href="{{ asset_prefix }}input.css" />
  </head>
  <body class="persona-registry">
    <main class="container">
      <header class="page-header">
        <p class="page-eyebrow"><a href="index.html">← FormGen</a></p>
        <h1 class="title is-3">Registry</h1>
        <p class="subtitle is-5">For executives and oversight.</p>
      </header>

      {% if rows %}
      <table class="table registry-table is-fullwidth is-hoverable">
        <thead>
          <tr>
            <th>System</th>
            <th>Residual risk</th>
            <th>Last assessed</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          <tr>
            <td>
              <a href="registry/{{ row.slug }}.html">{{ row.name }}</a>
              {% if row.stale_build %}
              <span class="tag is-warning is-light is-small ml-2" title="Made against build {{ row.record_build_id or 'unknown' }}; current build is {{ build_id }}">Stale build</span>
              {% endif %}
              {% if row.owner %}
              <p class="has-text-grey is-size-7">{{ row.owner }}</p>
              {% endif %}
            </td>
            <td>
              {% if row.has_assessment %}
              <span class="badge badge-{{ risk_level_colours.get(row.residual_level, 'gray') }}">
                {{ row.residual_level | replace("_", " ") }}
              </span>
              {% else %}
              <span class="has-text-grey">No assessment</span>
              {% endif %}
            </td>
            <td>{{ row.last_assessed }}</td>
            <td><a href="registry/{{ row.slug }}.html">View →</a></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <section class="registry-empty-state stack-md">
        <p>
          No systems registered yet. The risk manager commits each system's
          questionnaire and assessment JSON to <code>registry/&lt;slug&gt;/</code>
          to populate this view.
        </p>
        <p>
          <a href="index.html">← Back to FormGen</a>
        </p>
      </section>
      {% endif %}
      {% include "_footer.html.j2" %}
    </main>
  </body>
</html>

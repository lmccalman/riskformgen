<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Assessment — FormGen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="bulma.min.css" />
    <link rel="stylesheet" href="input.css" />
    <script defer src="alpine-persist.min.js"></script>
    <script defer src="app-assessment.js"></script>
    <script defer src="alpine3.15.8.min.js"></script>
  </head>
  <body class="persona-assessment">
    <main class="container">
      <header class="page-header">
        <p class="page-eyebrow"><a href="index.html">← FormGen</a></p>
        <h1 class="title is-3">Assessment</h1>
        <p class="subtitle is-5">For risk assessors. Judge the risks.</p>
      </header>

      <div x-data="assessment">
        {# ── Tab navigation ── #}
        <div class="tabs is-boxed">
          <ul>
            <li :class="activeTab === 'risks' && 'is-active'">
              <a @click="activeTab = 'risks'">Risk Analysis</a>
            </li>
            <li :class="activeTab === 'answers' && 'is-active'">
              <a @click="activeTab = 'answers'">Loaded Answers</a>
            </li>
            <li class="tab-spacer"></li>
            <li class="tab-debug" :class="activeTab === 'debug' && 'is-active'">
              <a @click="activeTab = 'debug'">Debug</a>
            </li>
          </ul>
        </div>

        {# ── Risks tab ── #}
        <div x-show="activeTab === 'risks'" class="stack-md">
          <section class="box loaded-system-identity stack-sm">
            <div>
              <span class="dim-label">System</span>
              <span x-text="system_name || '—'"></span>
            </div>
            <div>
              <span class="dim-label">Owner</span>
              <span x-text="system_owner || '—'"></span>
            </div>
          </section>

          <div class="load-questionnaire-bar">
            <p class="has-text-grey">
              Load a questionnaire JSON exported by a system owner to populate
              the risks below. To re-assess a system that has changed, also
              load the prior version (its questionnaire and assessment) — the
              page will diff against it.
            </p>
            <div class="save-load-bar save-load-bar-import-only">
              <button type="button" class="button is-light is-small" @click="$refs.answersFile.click()">
                Load questionnaire
              </button>
              <input
                type="file"
                accept=".json"
                x-ref="answersFile"
                @change="importAnswers($event)"
                hidden
              />
              <button type="button" class="button is-light is-small" @click="$refs.priorFiles.click()">
                Load prior version
              </button>
              <input
                type="file"
                accept=".json"
                x-ref="priorFiles"
                @change="loadPrior($event)"
                multiple
                hidden
              />
              <button
                type="button"
                class="button is-danger is-small is-outlined"
                x-show="diffMode"
                x-cloak
                @click="clearPrior()"
              >
                Clear prior
              </button>
            </div>
          </div>

          {# ── Re-assessment summary banner ── #}
          <div class="diff-summary-banner" x-show="diffMode" x-cloak>
            <div class="diff-summary-banner-head">
              <div>
                <h3 class="title is-5">Re-assessment of prior version</h3>
                <p class="has-text-grey">
                  Loaded prior assessment: <span x-text="prior_assessment_at || '—'"></span>.
                  Prior assessment values have been carried forward into the
                  inputs below; review and update only what changed.
                </p>
              </div>
              <label class="checkbox show-only-changed-toggle">
                <input type="checkbox" x-model="show_only_changed_risks" />
                Show only changed risks
              </label>
            </div>

            <p class="diff-summary-counter">
              <strong x-text="change_counts.risks"></strong>
              of <strong x-text="_riskIds.length"></strong>
              <span x-text="_riskIds.length === 1 ? 'risk has' : 'risks have'"></span>
              changed since the prior assessment.
            </p>

            <template x-if="changed_risk_ids.length">
              <div class="changed-risk-chip-list">
                <template x-for="rid in changed_risk_ids" :key="rid">
                  <a class="changed-risk-chip" :href="'#risk-' + rid">
                    <span class="changed-risk-chip-name"
                          x-text="rid.replace(/_/g, ' ')"></span>
                    <template x-for="kind in riskChangeKinds(rid)" :key="kind">
                      <span class="changed-risk-chip-kind"
                            :class="'changed-risk-chip-kind-' + kind"
                            x-text="kind"></span>
                    </template>
                  </a>
                </template>
              </div>
            </template>

            <template x-if="change_summary && change_summary.aggregate_change">
              <p class="diff-summary-aggregate">
                <span class="dim-label">Aggregate residual</span>
                <span
                  class="badge"
                  :class="'badge-' + ({ {% for level, colour in risk_level_colours.items() %}'{{ level }}': '{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %} }[change_summary.aggregate_change.level_before] || 'gray')"
                  x-text="(change_summary.aggregate_change.level_before || '—').replace(/_/g, ' ')"
                ></span>
                <span class="diff-summary-arrow">→</span>
                <span
                  class="badge"
                  :class="'badge-' + ({ {% for level, colour in risk_level_colours.items() %}'{{ level }}': '{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %} }[change_summary.aggregate_change.level_after] || 'gray')"
                  x-text="(change_summary.aggregate_change.level_after || '—').replace(/_/g, ' ')"
                ></span>
              </p>
            </template>

            <template x-if="change_summary && (
              Object.keys(change_summary.prior_only_ids).length ||
              Object.keys(change_summary.current_only_ids).length
            )">
              <details class="diff-summary-form-evolution">
                <summary>Form changes since prior version</summary>
                <div class="stack-sm">
                  <template x-for="kind in Object.keys(change_summary.prior_only_ids)" :key="'p-' + kind">
                    <p>
                      Prior only (<span x-text="kind"></span>):
                      <template x-for="id in change_summary.prior_only_ids[kind]" :key="id">
                        <code x-text="id" style="margin-right: 0.5em;"></code>
                      </template>
                    </p>
                  </template>
                  <template x-for="kind in Object.keys(change_summary.current_only_ids)" :key="'c-' + kind">
                    <p>
                      Current only (<span x-text="kind"></span>):
                      <template x-for="id in change_summary.current_only_ids[kind]" :key="id">
                        <code x-text="id" style="margin-right: 0.5em;"></code>
                      </template>
                    </p>
                  </template>
                </div>
              </details>
            </template>

            <template x-if="change_summary && !(
              change_summary.answer_changes.length ||
              change_summary.detail_changes.length ||
              change_summary.property_changes.length ||
              change_summary.risk_changes.length ||
              change_summary.residual_changes.length ||
              change_summary.mandate_changes.length ||
              change_summary.aggregate_change ||
              Object.keys(change_summary.prior_only_ids).length ||
              Object.keys(change_summary.current_only_ids).length
            )">
              <p class="has-text-grey diff-summary-empty">
                No changes between the loaded prior version and the current
                state. Edit answers (or load a different questionnaire) to see
                a diff.
              </p>
            </template>
          </div>

          {% if risks %}
          {% for risk in risks %}
          {% with risk=risk %}
          {% include "risk_summary.html.j2" %}
          {% endwith %}
          {% endfor %}

          <div
            class="card mb-4 aggregate-residual-card"
            x-show="aggregate_residual_level_default !== 'not_applicable'"
            x-cloak
          >
            <header class="card-header">
              <p class="card-header-title">Overall Residual Risk</p>
            </header>
            <div class="card-content risk-card-body">
              <p class="subtitle is-6 has-text-grey">
                Assign an overall residual risk level for the system based on
                your judgement of the per-risk residuals above. This need not
                be the worst per-risk level.
              </p>

              <div class="risk-card-section">
                <span class="dim-label">Suggested (worst per-risk)</span>
                <span
                  class="badge"
                  :class="'badge-' + ({ {% for level, colour in risk_level_colours.items() %}'{{ level }}': '{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %} }[aggregate_residual_level_default] || 'gray')"
                  x-text="aggregate_residual_level_default.replace(/_/g, ' ')"
                ></span>
              </div>

              <div class="risk-card-section">
                <label class="dim-label" for="aggregate_residual_level">Overall Residual Risk</label>
                <p
                  class="prior-residual-hint help"
                  x-show="diffMode && prior_assessment && prior_assessment.aggregate_residual_level"
                  x-cloak
                >
                  Previously: <span x-text="prior_assessment && prior_assessment.aggregate_residual_level"></span>
                </p>
                <div class="select">
                  <select id="aggregate_residual_level" x-model="aggregate_residual_level">
                    <option value="">— Use suggested —</option>
                    {% for level in risk_levels if level != "not_applicable" %}
                    <option value="{{ level }}">{{ level | replace("_", " ") | title }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>

              <div class="risk-card-section">
                <label class="dim-label" for="aggregate_residual_justification">Aggregate Justification</label>
                <textarea
                  class="textarea"
                  id="aggregate_residual_justification"
                  x-model="aggregate_residual_justification"
                  rows="3"
                  placeholder="Explain the system-level call — why this aggregate level reflects the residual risk picture as a whole…"
                ></textarea>
              </div>
            </div>
          </div>

          {% with export_fn="exportAssessment", import_fn="importAssessment", import_ref="assessmentFile", file_label="assessment", clear_fn="clearAssessment", clear_label="Clear assessment" %}
          {% include "save_load.html.j2" %}
          {% endwith %}
          {% else %}
          <p>No risks defined.</p>
          {% endif %}
        </div>

        {# ── Loaded answers (read-only summary) ── #}
        <div x-show="activeTab === 'answers'" class="stack-md">
          <p class="has-text-grey">
            The system owner's answers, as loaded from their questionnaire
            JSON. Read-only.
          </p>
          <section class="box loaded-system-identity stack-sm">
            <div>
              <span class="dim-label">System</span>
              <span x-text="system_name || '—'"></span>
            </div>
            <div>
              <span class="dim-label">Owner</span>
              <span x-text="system_owner || '—'"></span>
            </div>
          </section>
          <div class="diff-answers-toolbar" x-show="diffMode" x-cloak>
            <p class="diff-summary-counter">
              <strong x-text="change_counts.answers"></strong>
              <span x-text="change_counts.answers === 1 ? 'answer' : 'answers'"></span>
              and
              <strong x-text="change_counts.details"></strong>
              <span x-text="change_counts.details === 1 ? 'detail' : 'details'"></span>
              changed since the prior version.
            </p>
            <label class="checkbox show-only-changed-toggle">
              <input type="checkbox" x-model="show_only_changed_answers" />
              Show only changed answers
            </label>
          </div>
          {% include "answers_summary.html.j2" %}
        </div>

        {# ── Debug tab ── #}
        <div x-show="activeTab === 'debug'" class="debug-panel stack-md">
          <h3 class="title is-5">Loaded Answers</h3>
          <pre x-text="JSON.stringify(answers, null, 2)"></pre>
          {% if detail_ids %}
          <h3 class="title is-5">Loaded Details</h3>
          <pre x-text="JSON.stringify(details, null, 2)"></pre>
          {% endif %}
          {% if property_getters %}
          <h3 class="title is-5">Property States</h3>
          <pre x-text="JSON.stringify({
            {% for prop in property_getters %}
            '{{ prop.id }}': prop_{{ prop.id }}{% if not loop.last %},{% endif %}
            {% endfor %}
          }, null, 2)"></pre>
          {% endif %}
          {% if risks %}
          <h3 class="title is-5">Risk Levels</h3>
          <pre x-text="JSON.stringify({
            {% for risk in risks %}
            '{{ risk.id }}': {{ risk.id }}{% if not loop.last %},{% endif %}
            {% endfor %}
          }, null, 2)"></pre>
          <h3 class="title is-5">Control Effectiveness</h3>
          <pre x-text="JSON.stringify(control_effectiveness, null, 2)"></pre>
          <h3 class="title is-5">Residual Likelihood</h3>
          <pre x-text="JSON.stringify(residual_likelihood, null, 2)"></pre>
          <h3 class="title is-5">Residual Consequence</h3>
          <pre x-text="JSON.stringify(residual_consequence, null, 2)"></pre>
          <h3 class="title is-5">Justifications</h3>
          <pre x-text="JSON.stringify(justifications, null, 2)"></pre>
          <h3 class="title is-5">Mandated Controls</h3>
          <pre x-text="JSON.stringify(mandated_controls, null, 2)"></pre>
          <h3 class="title is-5">Mandated Comments</h3>
          <pre x-text="JSON.stringify(mandated_comments, null, 2)"></pre>
          <h3 class="title is-5">Aggregate Residual</h3>
          <pre x-text="JSON.stringify({
            level: aggregate_residual_level,
            level_default: aggregate_residual_level_default,
            justification: aggregate_residual_justification,
          }, null, 2)"></pre>
          {% endif %}
        </div>
      </div>
      {% include "_footer.html.j2" %}
    </main>
  </body>
</html>

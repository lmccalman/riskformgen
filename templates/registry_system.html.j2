<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ system_name }} — Registry — FormGen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="{{ asset_prefix }}bulma.min.css" />
    <link rel="stylesheet" href="{{ asset_prefix }}input.css" />
  </head>
  <body class="persona-registry">
    <main class="container">
      <header class="page-header registry-system-header">
        <p class="page-eyebrow"><a href="../registry.html">← Registry</a></p>
        <h1 class="title is-3">{{ system_name }}</h1>
        <p class="subtitle is-5">
          {% if system_owner %}{{ system_owner }} · {% endif %}Last assessed {{ exported_at }}
        </p>
      </header>

      {% if stale_build %}
      <div class="notification is-warning is-light stale-build-banner">
        <p>
          <strong>Stale build.</strong>
          This record was made against build
          <code>{{ record_build_id or 'unknown' }}</code>.
          The current form is build <code>{{ build_id }}</code>.
          The figures below reflect the form <em>as it was at the time</em>
          and may use older question wording or risk descriptions.
        </p>
      </div>
      {% endif %}

      {% if current_change_summary and not current_change_summary.is_empty %}
      <section class="stack-md change-summary-current">
        <h2 class="title is-4">Changes since previous version</h2>
        <p class="has-text-grey">
          What changed between the latest committed snapshot and the prior
          one in <code>history/</code>.
        </p>
        {% with summary=current_change_summary %}
        {% include "change_summary.html.j2" %}
        {% endwith %}
      </section>
      {% endif %}

      {% include "snapshot.html.j2" %}

      {% if history %}
      <section class="stack-md registry-history">
        <h2 class="title is-4">History</h2>
        <p class="has-text-grey">
          Prior committed snapshots, newest first. Expand any entry to see
          the snapshot as it stood at the time.
        </p>
        {% for entry in history %}
        <details class="registry-history-entry">
          <summary>
            <span class="history-summary-date">{{ entry.snapshot.exported_at }}</span>
            {% if entry.snapshot.has_assessment %}
            <span class="badge badge-{{ risk_level_colours.get(entry.snapshot.aggregate_residual_level, 'gray') }}">
              {{ entry.snapshot.aggregate_residual_level | replace("_", " ") }}
            </span>
            {% else %}
            <span class="has-text-grey">questionnaire only</span>
            {% endif %}
            {% if entry.snapshot.stale_build %}
            <span class="tag is-warning is-light is-small" title="Built against {{ entry.snapshot.record_build_id or 'unknown' }}">stale build</span>
            {% endif %}
          </summary>
          <div class="registry-history-body">
            {% if not entry.change_summary.is_empty %}
            <h3 class="title is-5">Changes from previous version</h3>
            {% with summary=entry.change_summary %}
            {% include "change_summary.html.j2" %}
            {% endwith %}
            {% else %}
            <p class="has-text-grey">First committed snapshot for this system.</p>
            {% endif %}
            <details class="registry-history-snapshot">
              <summary>Snapshot at this version</summary>
              <div class="registry-history-snapshot-body">
                {% with snapshot=entry.snapshot %}
                {% include "snapshot.html.j2" %}
                {% endwith %}
              </div>
            </details>
          </div>
        </details>
        {% endfor %}
      </section>
      {% endif %}

      {% include "_footer.html.j2" %}
    </main>
  </body>
</html>

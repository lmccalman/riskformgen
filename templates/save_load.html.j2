{# Save/load button bar — include with export_fn, import_fn, file_label set #}
<div class="save-load-bar">
  <button type="button" class="button is-primary is-small" @click="{{ export_fn }}()">Save {{ file_label }}</button>
  <button type="button" class="button is-light is-small" @click="$refs.{{ import_ref }}.click()">
    Load {{ file_label }}
  </button>
  <input
    type="file"
    accept=".json"
    x-ref="{{ import_ref }}"
    @change="{{ import_fn }}($event)"
    hidden
  />
  {% if clear_fn is defined and clear_fn %}
  <button type="button" class="button is-danger is-small is-outlined" @click="{{ clear_fn }}()">Clear all</button>
  {% endif %}
</div>
